# Canonical origin (no trailing slash). Defaults to https://24shoots.es
SITE_URL=https://24shoots.es

# Contact form delivery (https://resend.com). Without a key the form returns an
# honest error and shows the email address instead of pretending it was sent.
RESEND_API_KEY=
# Recipient (default info@24shoots.es)
CONTACT_TO=info@24shoots.es
# Sender — the domain must be verified in Resend (SPF/DKIM DNS records)
CONTACT_FROM="24SHOOTS web <web@24shoots.es>"

# Local testing only: log enquiries instead of sending them
# CONTACT_DRY_RUN=1

# ---- Provider-neutral switches (Vercel or Cloudflare) ----
# production = indexable. Anything else (or unset on Cloudflare previews) = noindex.
# On Cloudflare it must be set both when building (cf:build) and in wrangler.jsonc vars.
SITE_ENV=preview
# Public origin of the R2 bucket that holds the full films (Cloudflare). Empty = /public.
NEXT_PUBLIC_FILM_BASE=
# Cloudflare Web Analytics token (cookieless, free). Empty = no beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
